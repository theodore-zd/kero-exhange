{% extends "admin/base.grov" %}


{% block title %}wallets — kero admin{% endblock %}

{% block admin_content %}
<div class="page-header">
    <h1>wallets</h1>
    <a href="/admin/wallets/new" class="btn btn-primary">create wallet</a>
</div>

<div id="error" class="alert alert-error" style="display:none;"></div>
<div id="loading">loading&#x2026;</div>

<table id="wallets-table" style="display:none;">
    <thead>
        <tr>
            <th>uuid</th>
            <th>created</th>
            <th>actions</th>
        </tr>
    </thead>
    <tbody id="wallets-body"></tbody>
</table>
<div id="no-wallets" style="display:none;">no wallets found</div>
<div id="pagination"></div>

<script>
(async function() {
    var params = new URLSearchParams(window.location.search);
    var page = params.get('page') || 1;
    try {
        var resp = await adminFetch('/api/v1/admin/wallets?page=' + page);
        var result = await parseResponse(resp, 'wallets');
        if (!result || result._error) {
            showError('error', result ? result._error : 'failed to load wallets');
            return;
        }
        var wallets = result.data || [];
        var meta = result.meta || {};
        var tbody = document.getElementById('wallets-body');

        if (wallets.length === 0) {
            document.getElementById('no-wallets').style.display = '';
        } else {
            wallets.forEach(function(w) {
                var tr = document.createElement('tr');

                var tdId = document.createElement('td');
                tdId.appendChild(truncateUUID(w.uuid, '/admin/wallets/' + w.uuid));

                var tdDate = document.createElement('td');
                tdDate.textContent = formatDate(w.created_at);

                var tdActions = document.createElement('td');

                var regenLink = document.createElement('a');
                regenLink.href = '/admin/wallets/' + w.uuid + '/regenerate';
                regenLink.textContent = 'regen';
                regenLink.className = 'btn btn-secondary btn-sm';

                var issueLink = document.createElement('a');
                issueLink.href = '/admin/wallets/' + w.uuid + '/issue-currency';
                issueLink.textContent = 'issue';
                issueLink.className = 'btn btn-secondary btn-sm';

                var delBtn = document.createElement('button');
                delBtn.textContent = 'delete';
                delBtn.className = 'btn btn-danger btn-sm';
                delBtn.addEventListener('click', async function() {
                    if (!confirm('delete wallet ' + w.uuid + '?')) return;
                    var dr = await adminFetch('/api/v1/admin/wallets/' + w.uuid, { method: 'DELETE' });
                    if (dr && dr.ok) { tr.remove(); } else {
                        showError('error', 'failed to delete wallet ' + w.uuid);
                    }
                });

                tdActions.appendChild(regenLink);
                tdActions.appendChild(document.createTextNode(' '));
                tdActions.appendChild(issueLink);
                tdActions.appendChild(document.createTextNode(' '));
                tdActions.appendChild(delBtn);

                tr.appendChild(tdId);
                tr.appendChild(tdDate);
                tr.appendChild(tdActions);
                tbody.appendChild(tr);
            });
            document.getElementById('wallets-table').style.display = '';
        }

        renderPagination('pagination', meta);
    } catch (err) {
        showError('error', 'failed to load wallets', err);
    } finally {
        document.getElementById('loading').style.display = 'none';
    }
})();
</script>
{% endblock %}
