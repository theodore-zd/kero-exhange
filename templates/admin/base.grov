{% extends "base.grov" %}

{% block head %}
<script src="/static/js/utils.js"></script>
<script src="/static/js/admin.js"></script>
{% endblock %}

{% block content %}
<div class="layout">
    <aside class="sidebar">
        <div class="brand mb-2">kero admin</div>
        <ul class="sidebar-nav">
            <li><a href="/admin/dashboard" class="{% if active == 'dashboard' %}active{% endif %}">dashboard</a></li>
            <li><a href="/admin/providers" class="{% if active == 'providers' %}active{% endif %}">providers</a></li>
            <li><a href="/admin/wallets" class="{% if active == 'wallets' %}active{% endif %}">wallets</a></li>
            <li><a href="/admin/currencies" class="{% if active == 'currencies' %}active{% endif %}">currencies</a></li>
            <li><a href="/admin/transactions" class="{% if active == 'transactions' %}active{% endif %}">transactions</a></li>
            <li><a href="/admin/audit-log" class="{% if active == 'audit-log' %}active{% endif %}">audit log</a></li>
            <li><a href="/admin/lookup" class="{% if active == 'lookup' %}active{% endif %}">lookup</a></li>
            <li><a href="#" onclick="adminSignOut(); return false;">logout</a></li>
        </ul>
    </aside>
    <div class="main-content">
        {% block admin_content %}{% endblock %}
    </div>
</div>
{% endblock %}
