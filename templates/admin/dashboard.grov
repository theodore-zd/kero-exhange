{% extends "admin/base.grov" %}

{% block title %}admin dashboard — kero-exchange{% endblock %}

{% block admin_content %}
<div class="page-header">
    <h1>dashboard</h1>
</div>

<div id="error" class="alert alert-error" style="display:none;"></div>
<div id="stats" class="stats-grid" style="display:none;">
    <div class="stat-card">
        <div class="label">providers</div>
        <div class="value" id="provider-count">&#8212;</div>
    </div>
    <div class="stat-card">
        <div class="label">wallets</div>
        <div class="value" id="wallet-count">&#8212;</div>
    </div>
    <div class="stat-card">
        <div class="label">currencies</div>
        <div class="value" id="currency-count">&#8212;</div>
    </div>
</div>
<div id="loading">loading&#x2026;</div>

<script>
(async function() {
    try {
        var results = await Promise.all([
            adminFetch('/api/v1/admin/providers?page_size=1'),
            adminFetch('/api/v1/admin/wallets?page_size=1'),
            adminFetch('/api/v1/admin/currencies?page_size=1')
        ]);
        var labels = ['providers', 'wallets', 'currencies'];
        var parsed = [];
        for (var i = 0; i < results.length; i++) {
            var p = await parseResponse(results[i], 'dashboard/' + labels[i]);
            if (!p || p._error) {
                showError('error', 'failed to load ' + labels[i] + ' stats', p && p._error);
                return;
            }
            parsed.push(p);
        }
        document.getElementById('provider-count').textContent = (parsed[0].meta && parsed[0].meta.total != null) ? parsed[0].meta.total : '—';
        document.getElementById('wallet-count').textContent = (parsed[1].meta && parsed[1].meta.total != null) ? parsed[1].meta.total : '—';
        document.getElementById('currency-count').textContent = (parsed[2].meta && parsed[2].meta.total != null) ? parsed[2].meta.total : '—';
        document.getElementById('stats').style.display = '';
    } catch (err) {
        showError('error', 'failed to load dashboard', err);
    } finally {
        document.getElementById('loading').style.display = 'none';
    }
})();
</script>
{% endblock %}
