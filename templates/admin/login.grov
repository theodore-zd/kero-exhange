{% extends "base.grov" %}

{% block title %}admin login — kero-exchange{% endblock %}

{% block content %}
<div class="auth-container">
    <h1>admin login</h1>
    <div id="error" class="alert alert-error" style="display:none;"></div>
    <form id="login-form">
        <div class="form-group">
            <label for="password">password</label>
            <input type="password" id="password" name="password" required autofocus />
        </div>
        <button type="submit" class="btn btn-primary">login</button>
    </form>
</div>
{% endblock %}

{% block head %}
<script src="/static/js/utils.js"></script>
<script src="/static/js/admin.js"></script>
{% endblock %}

{% block scripts %}
<script>
document.getElementById('login-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    var password = document.getElementById('password').value;
    document.getElementById('error').style.display = 'none';

    console.info('[admin] attempting login');
    try {
        var resp = await fetch('/api/v1/admin/login', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ password: password })
        });
        var resp_body = await resp.json();
        if (!resp.ok) {
            var msg = (resp_body.error && resp_body.error.message) || 'login failed';
            console.warn('[admin] login failed:', msg, 'status=' + resp.status);
            showError('error', msg);
            return;
        }
        if (!resp_body.data || !resp_body.data.token) {
            console.error('[admin] login response missing token:', resp_body);
            showError('error', 'login failed: no token in response');
            return;
        }
        console.info('[admin] login successful');
        setAdminToken(resp_body.data.token);
        window.location.href = '/admin/dashboard';
    } catch (err) {
        showError('error', 'login failed: network error', err);
    }
});
</script>
{% endblock %}
