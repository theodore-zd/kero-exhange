{% extends "admin/base.grov" %}

{% block title %}providers — kero admin{% endblock %}

{% block admin_content %}
<div class="page-header">
    <h1>providers</h1>
    <a href="/admin/providers/new" class="btn btn-primary">add provider</a>
</div>

<div id="error" class="alert alert-error" style="display:none;"></div>
<div id="loading">loading&#x2026;</div>

<table id="providers-table" style="display:none;">
    <thead>
        <tr>
            <th>name</th>
            <th>created</th>
            <th>actions</th>
        </tr>
    </thead>
    <tbody id="providers-body"></tbody>
</table>
<div id="no-providers" style="display:none;">no providers found</div>
<div id="pagination"></div>
{% endblock %}

{% block scripts %}
<script>
(async function() {
    var params = new URLSearchParams(window.location.search);
    var page = params.get('page') || 1;
    try {
        var resp = await adminFetch('/api/v1/admin/providers?page=' + page);
        var result = await parseResponse(resp, 'providers');
        if (!result || result._error) {
            showError('error', result ? result._error : 'failed to load providers');
            return;
        }
        var providers = result.data || [];
        var meta = result.meta || {};
        var tbody = document.getElementById('providers-body');

        if (providers.length === 0) {
            document.getElementById('no-providers').style.display = '';
        } else {
            providers.forEach(function(p) {
                var tr = document.createElement('tr');
                var tdName = document.createElement('td');
                tdName.textContent = p.name || '—';
                var tdDate = document.createElement('td');
                tdDate.textContent = formatDate(p.created_at);
                var tdActions = document.createElement('td');

                var editLink = document.createElement('a');
                editLink.href = '/admin/providers/' + p.uuid + '/edit-api-key';
                editLink.textContent = 'regen key';
                editLink.className = 'btn btn-secondary btn-sm';

                var delBtn = document.createElement('button');
                delBtn.textContent = 'delete';
                delBtn.className = 'btn btn-danger btn-sm';
                delBtn.addEventListener('click', async function() {
                    if (!confirm('delete provider ' + p.name + '?')) return;
                    var dr = await adminFetch('/api/v1/admin/providers/' + p.uuid, { method: 'DELETE' });
                    if (dr && dr.ok) { tr.remove(); } else {
                        showError('error', 'failed to delete provider ' + p.name);
                    }
                });

                tdActions.appendChild(editLink);
                tdActions.appendChild(document.createTextNode(' '));
                tdActions.appendChild(delBtn);
                tr.appendChild(tdName);
                tr.appendChild(tdDate);
                tr.appendChild(tdActions);
                tbody.appendChild(tr);
            });
            document.getElementById('providers-table').style.display = '';
        }

        renderPagination('pagination', meta);
    } catch (err) {
        showError('error', 'failed to load providers', err);
    } finally {
        document.getElementById('loading').style.display = 'none';
    }
})();
</script>
{% endblock %}
