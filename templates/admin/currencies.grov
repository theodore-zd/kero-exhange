{% extends "admin/base.grov" %}

{% block title %}currencies — kero admin{% endblock %}

{% block admin_content %}
<div class="page-header">
    <h1>currencies</h1>
    <a href="/admin/currencies/new" class="btn btn-primary">add currency</a>
</div>

<div id="error" class="alert alert-error" style="display:none;"></div>
<div id="loading">loading&#x2026;</div>

<table id="currencies-table" style="display:none;">
    <thead>
        <tr>
            <th>code</th>
            <th>name</th>
            <th>description</th>
            <th>actions</th>
        </tr>
    </thead>
    <tbody id="currencies-body"></tbody>
</table>
<div id="no-currencies" style="display:none;">no currencies found</div>
<div id="pagination"></div>
{% endblock %}

{% block scripts %}
<script>
(async function() {
    var params = new URLSearchParams(window.location.search);
    var page = params.get('page') || 1;
    try {
        var resp = await adminFetch('/api/v1/admin/currencies?page=' + page);
        var result = await parseResponse(resp, 'currencies');
        if (!result || result._error) {
            showError('error', result ? result._error : 'failed to load currencies');
            return;
        }
        var currencies = result.data || [];
        var meta = result.meta || {};
        var tbody = document.getElementById('currencies-body');

        if (currencies.length === 0) {
            document.getElementById('no-currencies').style.display = '';
        } else {
            currencies.forEach(function(c) {
                var tr = document.createElement('tr');
                var cells = [c.code || '—', c.name || '—', c.description || '—'];
                cells.forEach(function(val) {
                    var td = document.createElement('td');
                    td.textContent = val;
                    tr.appendChild(td);
                });
                var tdActions = document.createElement('td');
                var delBtn = document.createElement('button');
                delBtn.textContent = 'delete';
                delBtn.className = 'btn btn-danger btn-sm';
                delBtn.addEventListener('click', async function() {
                    if (!confirm('delete currency ' + c.code + '?')) return;
                    var dr = await adminFetch('/api/v1/admin/currencies/' + c.uuid, { method: 'DELETE' });
                    if (dr && dr.ok) { tr.remove(); } else {
                        showError('error', 'failed to delete currency ' + c.code);
                    }
                });
                tdActions.appendChild(delBtn);
                tr.appendChild(tdActions);
                tbody.appendChild(tr);
            });
            document.getElementById('currencies-table').style.display = '';
        }

        renderPagination('pagination', meta);
    } catch (err) {
        showError('error', 'failed to load currencies', err);
    } finally {
        document.getElementById('loading').style.display = 'none';
    }
})();
</script>
{% endblock %}
