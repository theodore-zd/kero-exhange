{% extends "base.grov" %}

{% block title %}transfer — kero-exchange{% endblock %}

{% block nav %}
{% include "components/nav.grov" active=active %}
{% endblock %}

{% block content %}
<div class="page-header">
    <h1>transfer</h1>
</div>

<div id="error" class="alert alert-error" style="display:none;"></div>
<div id="success-panel" style="display:none;">
    <div class="alert alert-success">transfer complete</div>
    <dl>
        <dt>transfer id</dt><dd id="result-id">&#8212;</dd>
        <dt>debit amount</dt><dd id="result-debit">&#8212;</dd>
        <dt>credit amount</dt><dd id="result-credit">&#8212;</dd>
    </dl>
    <a href="/transfer" class="btn btn-secondary">new transfer</a>
</div>

<form id="transfer-form">
    <div class="form-group">
        <label for="destination">destination wallet uuid</label>
        <input type="text" id="destination" name="destination" required placeholder="xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx" />
    </div>
    <div class="form-group">
        <label for="currency">currency</label>
        <select id="currency" name="currency" required>
            <option value="">loading currencies&#x2026;</option>
        </select>
    </div>
    <div class="form-group">
        <label for="amount">amount</label>
        <input type="number" id="amount" name="amount" required min="0.00000001" step="0.00000001" />
    </div>
    <button type="submit" class="btn btn-primary">transfer</button>
</form>
{% endblock %}

{% block scripts %}
<script src="/static/js/app.js"></script>
<script>
(async function() {
    var select = document.getElementById('currency');
    try {
        var resp = await apiFetch('/api/v1/currencies');
        if (resp && resp.ok) {
            var data = await resp.json();
            var currencies = data.data || [];
            while (select.firstChild) { select.removeChild(select.firstChild); }
            if (currencies.length === 0) {
                var opt = document.createElement('option');
                opt.value = '';
                opt.textContent = 'no currencies available';
                select.appendChild(opt);
            } else {
                currencies.forEach(function(c) {
                    var opt = document.createElement('option');
                    opt.value = c.uuid || c.id;
                    opt.textContent = c.code + (c.name ? ' — ' + c.name : '');
                    select.appendChild(opt);
                });
            }
        }
    } catch (err) {
        while (select.firstChild) { select.removeChild(select.firstChild); }
        var errOpt = document.createElement('option');
        errOpt.value = '';
        errOpt.textContent = 'failed to load currencies';
        select.appendChild(errOpt);
    }
})();

document.getElementById('transfer-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    var errorDiv = document.getElementById('error');
    errorDiv.style.display = 'none';

    var destination = document.getElementById('destination').value.trim();
    var currencyId = document.getElementById('currency').value;
    var amount = document.getElementById('amount').value;

    if (!confirm('transfer ' + amount + ' to wallet ' + destination + '?')) return;

    try {
        var resp = await apiFetch('/api/v1/transfers', {
            method: 'POST',
            body: { destination_wallet_uuid: destination, currency_id: currencyId, amount: amount }
        });
        if (!resp) return;
        var data = await resp.json();
        if (!resp.ok) {
            errorDiv.textContent = data.error || 'transfer failed';
            errorDiv.style.display = '';
            return;
        }
        document.getElementById('result-id').textContent = data.transfer_id || '—';
        document.getElementById('result-debit').textContent = data.debit_amount || '—';
        document.getElementById('result-credit').textContent = data.credit_amount || '—';
        document.getElementById('transfer-form').style.display = 'none';
        document.getElementById('success-panel').style.display = '';
    } catch (err) {
        errorDiv.textContent = 'network error';
        errorDiv.style.display = '';
    }
});
</script>
{% endblock %}
