{% extends "base.grov" %}

{% block title %}sign in — kero-exchange{% endblock %}

{% block head %}
<script src="/static/js/utils.js"></script>
<script src="/static/js/app.js"></script>
{% endblock %}

{% block content %}
<div class="auth-container">
    <h1>sign in</h1>
    <div id="error" class="alert alert-error" style="display:none;"></div>
    <form id="signin-form">
        <div class="form-group">
            <label for="passphrase">passphrase</label>
            <input type="password" id="passphrase" name="passphrase" required autofocus />
        </div>
        <button type="submit" class="btn btn-primary">sign in</button>
    </form>
</div>
{% endblock %}

{% block scripts %}
<script>
document.getElementById('signin-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    var passphrase = document.getElementById('passphrase').value;
    document.getElementById('error').style.display = 'none';

    try {
        var resp = await fetch('/api/v1/auth/signin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ passphrase: passphrase })
        });
        var result = await resp.json();
        if (!resp.ok) {
            showError('error', (result.error && result.error.message) || 'sign in failed');
            return;
        }
        setAccessToken(result.data.access_token);
        setWalletUUID(result.data.wallet_uuid);
        window.location.href = '/dashboard';
    } catch (err) {
        showError('error', 'network error');
    }
});
</script>
{% endblock %}
