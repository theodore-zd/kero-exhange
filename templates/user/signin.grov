{% extends "base.grov" %}

{% block title %}sign in — kero-exchange{% endblock %}

{% block content %}
<div class="auth-container">
    <h1>sign in</h1>
    <div id="error" class="alert alert-error" style="display:none;"></div>
    <form id="signin-form">
        <div class="form-group">
            <label for="passphrase">passphrase</label>
            <input type="password" id="passphrase" name="passphrase" required autofocus />
        </div>
        <button type="submit" class="btn btn-primary">sign in</button>
    </form>
</div>
{% endblock %}

{% block scripts %}
<script src="/static/js/app.js"></script>
<script>
document.getElementById('signin-form').addEventListener('submit', async function(e) {
    e.preventDefault();
    const passphrase = document.getElementById('passphrase').value;
    const errorDiv = document.getElementById('error');
    errorDiv.style.display = 'none';

    try {
        const resp = await fetch('/api/v1/auth/signin', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ passphrase })
        });
        const result = await resp.json();
        if (!resp.ok) {
            errorDiv.textContent = result.error || 'sign in failed';
            errorDiv.style.display = '';
            return;
        }
        setAccessToken(result.data.access_token);
        setWalletUUID(result.data.wallet_uuid);
        window.location.href = '/dashboard';
    } catch (err) {
        errorDiv.textContent = 'network error';
        errorDiv.style.display = '';
    }
});
</script>
{% endblock %}
