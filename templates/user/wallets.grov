{% extends "base.grov" %}
{% set active = "wallets" %}

{% block title %}wallets — kero-exchange{% endblock %}

{% block nav %}
{% include "components/nav.grov" active=active %}
{% endblock %}

{% block content %}
<div class="page-header">
    <h1>wallets</h1>
</div>

<div id="error" class="alert alert-error" style="display:none;"></div>
<div id="loading">loading&#x2026;</div>

<table id="wallets-table" style="display:none;">
    <thead>
        <tr>
            <th>uuid</th>
            <th>created</th>
        </tr>
    </thead>
    <tbody id="wallets-body"></tbody>
</table>
<div id="no-wallets" style="display:none;">no wallets found</div>
<div id="pagination"></div>
{% endblock %}

{% block scripts %}
<script src="/static/js/app.js"></script>
<script>
(async function() {
    var errorDiv = document.getElementById('error');
    var params = new URLSearchParams(window.location.search);
    var page = params.get('page') || 1;
    try {
        var resp = await apiFetch('/api/v1/wallets?page=' + page);
        if (!resp) return;
        if (!resp.ok) {
            var errData = await resp.json();
            errorDiv.textContent = errData.error || 'failed to load wallets';
            errorDiv.style.display = '';
            return;
        }
        var result = await resp.json();
        var wallets = result.data || [];
        var meta = result.meta || {};

        var tbody = document.getElementById('wallets-body');
        if (wallets.length === 0) {
            document.getElementById('no-wallets').style.display = '';
        } else {
            wallets.forEach(function(w) {
                var tr = document.createElement('tr');
                var tdId = document.createElement('td');
                var a = document.createElement('a');
                a.href = '/wallets/' + w.uuid;
                a.textContent = w.uuid;
                tdId.appendChild(a);
                var tdDate = document.createElement('td');
                tdDate.textContent = w.created_at || '—';
                tr.appendChild(tdId);
                tr.appendChild(tdDate);
                tbody.appendChild(tr);
            });
            document.getElementById('wallets-table').style.display = '';
        }

        if (meta.total_pages > 1) {
            var pag = document.getElementById('pagination');
            pag.className = 'pagination';
            var currentPage = parseInt(meta.page, 10);
            var totalPages = parseInt(meta.total_pages, 10);
            if (currentPage > 1) {
                var prev = document.createElement('a');
                prev.href = '?page=' + (currentPage - 1);
                prev.textContent = '< prev';
                pag.appendChild(prev);
            }
            for (var p = 1; p <= totalPages; p++) {
                if (p === currentPage) {
                    var span = document.createElement('span');
                    span.className = 'active';
                    span.textContent = p;
                    pag.appendChild(span);
                } else {
                    var aPage = document.createElement('a');
                    aPage.href = '?page=' + p;
                    aPage.textContent = p;
                    pag.appendChild(aPage);
                }
            }
            if (currentPage < totalPages) {
                var next = document.createElement('a');
                next.href = '?page=' + (currentPage + 1);
                next.textContent = 'next >';
                pag.appendChild(next);
            }
        }
    } catch (err) {
        errorDiv.textContent = 'network error';
        errorDiv.style.display = '';
    } finally {
        document.getElementById('loading').style.display = 'none';
    }
})();
</script>
{% endblock %}
